# Canonical site URL (no trailing slash). Used for metadata, sitemap, OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Preferred: Resend. Get a key at https://resend.com/api-keys
# Until a domain is verified in Resend, use the sandbox sender below.
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM=Trust Williams <onboarding@resend.dev>
# CONTACT_TO=Taresy.dev@gmail.com

# Fallback if Resend is not set: https://formspree.io (form id only, not the full URL)
# FORMSPREE_FORM_ID=xxxxxxxx

# Persist analytics across serverless instances (Upstash Redis REST)
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx
